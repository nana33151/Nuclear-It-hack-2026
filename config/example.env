# Nuclear-It-hack-2026 — конфиг прогона.
# Скопируй в .env: cp config/example.env .env
# Приоритет: CLI-флаги > .env > app/config.yaml
# Если .env не читается pipeline.py (см. README), файл — документация
# прогона, на который можно ссылаться в docs/TEST_RESULTS.md.

# --- Пути ---
VIDEO_DIR=Video
OUTPUT_DIR=output

# --- Окно обработки ---
# Валидационное окно, на котором получен рабочий результат
START_SEC=175
MAX_SEC=15
STRIDE=5
# Пусто = все *.mkv из VIDEO_DIR; иначе через запятую
CAMERAS=camera_new_2,camera_new_3

# --- Детекция (YOLO11-seg) ---
YOLO_WEIGHTS=person1/models/yolo11s-seg.pt
IMGSZ=640
CONFIDENCE=0.45
IOU=0.7

# --- ReID ---
# solider | color
REID_BACKEND=solider
# swin_tiny | swin_small | swin_base
REID_VARIANT=swin_small
REID_WEIGHTS=weights/swin_s_market.pth
# auto | cpu | cuda | mps
REID_DEVICE=auto

# --- Merge (GlobalTracker) ---
MERGE_T=8.0
MERGE_MIN_SIM=0.55
MERGE_MAX_TRANSITION_TIME=12.0
MERGE_LOST_TIMEOUT_SEC=10.0
MERGE_ENABLE_BEV=true
MERGE_MIRROR_FILTER=true
MERGE_DEBUG=false

# --- Export ---
EXPORT_MP4=true
DISPLAY_MAX_SIDE=960